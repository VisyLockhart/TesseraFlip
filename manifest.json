{
  "manifest_version": 3,
  "name": "TesseraFlip",
  "version": "0.0.1",
  "description": "Rotate, step, and save YouTube frames.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/config.js",
        "src/i18n.js",
        "src/locator.js",
        "src/controller.js",
        "src/rotation.js",
        "src/stepper.js",
        "src/frame.js",
        "src/keys.js",
        "src/slider.js",
        "src/ui.js",
        "src/main.js"
      ],
      "run_at": "document_idle",
      "css": [
        "src/tesseraflip.css"
      ]
    }
  ]
}
